{
  "version": 1,
  "_doc": [
    "Snapshot of the platform <-> bridge schema. Locked by tests/test_bridge_contract.py.",
    "",
    "Three surfaces are tracked:",
    "  1. bridge_request_body_top_level     - keys in the POST /v1/tenants body.",
    "  2. bridge_request_agent_config_fields - keys inside body.agent_config",
    "                                          (output of _agent_config_to_bridge_body).",
    "  3. agent_env_contract_keys           - keys produced by",
    "                                          AgentEnvContract.to_env_lines() with",
    "                                          every Optional field populated.",
    "",
    "Drift in any surface fails CI. To accept drift intentionally:",
    "  a. Update the bridge's Pydantic AgentConfig model + _build_env on the VPS.",
    "  b. Bump BRIDGE_SCHEMA_VERSION in app/types/agent_env.py.",
    "  c. Update this file and rename it to bridge_schema_v<N>.json.",
    "",
    "Why this exists: the bridge's AgentConfig silently drops unknown fields.",
    "Two production incidents (matin 2026-04-27 on llm_mode, whatsapp_mode 2026-04-30)",
    "were caused by adding fields to the platform without updating the bridge.",
    "This contract makes such drift impossible to land silently."
  ],

  "bridge_request_body_top_level": [
    "agent_config",
    "image_tag",
    "prefix",
    "user_id"
  ],

  "bridge_request_agent_config_fields": [
    "agent_color",
    "agent_model",
    "anthropic_api_key",
    "brave_api_key",
    "connect_token",
    "deepseek_api_key",
    "discord_bot_token",
    "elevenlabs_api_key",
    "google_api_key",
    "llm_mode",
    "mistral_api_key",
    "openai_api_key",
    "slack_app_token",
    "slack_bot_token",
    "telegram_bot_token",
    "whatsapp_access_token",
    "whatsapp_app_secret",
    "whatsapp_baileys_allowlist",
    "whatsapp_mode",
    "whatsapp_phone_number_id",
    "whatsapp_self_e164",
    "whatsapp_verify_token",
    "xai_api_key"
  ],

  "agent_env_contract_keys": [
    "AGENT_API_KEY",
    "AGENT_COLOR",
    "AGENT_MODEL",
    "AGENT_PORT",
    "AGENT_WORKSPACE_DIR",
    "ANTHROPIC_API_KEY",
    "DATABASE_URL",
    "DEEPSEEK_API_KEY",
    "DISCORD_BOT_TOKEN",
    "ENABLE_DAY_RECALL",
    "GOOGLE_API_KEY",
    "MISTRAL_API_KEY",
    "OPENAI_API_KEY",
    "PLATFORM_API_URL",
    "RUN_MODE",
    "SKILLS_DIR",
    "TELEGRAM_BOT_TOKEN",
    "TOUP_APPS_DIR",
    "TOUP_TOKEN",
    "USER_ID",
    "USE_DAY_CHAT_CONTEXT",
    "XAI_API_KEY"
  ]
}
