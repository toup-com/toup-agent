{
  "name": "real_estate",
  "keywords": ["real estate", "property", "listing", "homes", "realtor", "broker", "house", "apartment", "rental", "mortgage", "agent"],
  "description": "Workflows for real estate professionals: lead follow-ups, market reports, and open house preparation",
  "workflows": [
    {
      "name": "New Lead Follow-Up",
      "description": "Extract lead details from input, save to memory, and draft a personalized follow-up email",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_manual",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Enter Lead Info",
            "templateType": "trigger_manual",
            "config": {}
          }
        },
        {
          "id": "node_2",
          "type": "ai_extract",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Extract Lead Details",
            "templateType": "ai_extract",
            "config": {
              "prompt": "Extract lead details from this real estate inquiry.",
              "fields": ["name", "email", "phone", "property_interest", "budget", "location_preference", "timeline"]
            }
          }
        },
        {
          "id": "node_3",
          "type": "action_memory_store",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Save Lead",
            "templateType": "action_memory_store",
            "config": {
              "content": "{{input.extracted}}",
              "metadata": {
                "type": "real_estate_lead"
              }
            }
          }
        },
        {
          "id": "node_4",
          "type": "ai_chat",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Draft Follow-Up Email",
            "templateType": "ai_chat",
            "config": {
              "model": "default",
              "prompt": "Draft a warm, professional follow-up email for a new real estate lead. Reference their specific interests and preferences. Suggest scheduling a call or viewing.\n\nLead details: {{input.extracted}}",
              "temperature": 0.7
            }
          }
        },
        {
          "id": "node_5",
          "type": "output_respond",
          "position": {"x": 1100, "y": 200},
          "data": {
            "label": "Show Email Draft",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"},
        {"id": "e4", "source": "node_4", "target": "node_5"}
      ]
    },
    {
      "name": "Weekly Market Report",
      "description": "Compiles a weekly market analysis from recent listing data every Monday at 8 AM",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_schedule",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Weekly Monday 8 AM",
            "templateType": "trigger_schedule",
            "config": {
              "cron": "0 8 * * 1"
            }
          }
        },
        {
          "id": "node_2",
          "type": "action_memory_search",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Search Recent Listings",
            "templateType": "action_memory_search",
            "config": {
              "query": "recent listings, property prices, market trends, new properties, sold properties"
            }
          }
        },
        {
          "id": "node_3",
          "type": "ai_agent",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Compile Market Analysis",
            "templateType": "ai_agent",
            "config": {
              "prompt": "Compile a weekly real estate market report from these recent listings and data. Include: market trends, price changes, hot neighborhoods, inventory levels, and recommendations for buyers and sellers.\n\nData: {{input.results}}",
              "model": "default"
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Deliver Report",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    },
    {
      "name": "Open House Prep Checklist",
      "description": "Generate a comprehensive open house preparation checklist and save it for reference",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_manual",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Enter Property Details",
            "templateType": "trigger_manual",
            "config": {}
          }
        },
        {
          "id": "node_2",
          "type": "ai_agent",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Generate Checklist",
            "templateType": "ai_agent",
            "config": {
              "prompt": "Generate a detailed open house preparation checklist based on these property details. Include: staging tips, marketing materials needed, signage, refreshments, documentation to prepare, safety measures, and follow-up tasks.\n\nProperty: {{input.text}}",
              "model": "default"
            }
          }
        },
        {
          "id": "node_3",
          "type": "action_memory_store",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Save Checklist",
            "templateType": "action_memory_store",
            "config": {
              "content": "{{input.text}}",
              "metadata": {
                "type": "open_house_checklist"
              }
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Show Checklist",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    }
  ]
}
