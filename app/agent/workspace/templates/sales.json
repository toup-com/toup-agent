{
  "name": "sales",
  "keywords": ["sales", "pipeline", "deal", "prospect", "crm", "revenue", "closing", "quota", "lead", "b2b", "b2c", "selling"],
  "description": "Sales workflows for pipeline management, follow-ups, and deal tracking",
  "workflows": [
    {
      "name": "Pipeline Daily Update",
      "description": "Every morning, compiles a status update of all active deals in the pipeline",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_schedule",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Daily Morning Trigger",
            "templateType": "trigger_schedule",
            "config": {
              "cron": "0 8 * * *"
            }
          }
        },
        {
          "id": "node_2",
          "type": "action_memory_search",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Search Active Deals",
            "templateType": "action_memory_search",
            "config": {
              "query": "active deals pipeline opportunities in progress"
            }
          }
        },
        {
          "id": "node_3",
          "type": "ai_agent",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Compile Pipeline Status",
            "templateType": "ai_agent",
            "config": {
              "model": "default",
              "prompt": "You are a sales operations assistant. Compile a concise daily pipeline update from these deal records. Include deal stage, expected close date, value, and any blockers. Prioritize deals closest to closing:\n\n{{input.text}}",
              "temperature": 0.4
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Send Update",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    },
    {
      "name": "Follow-Up Reminder",
      "description": "Daily check for contacts needing follow-up, with AI-drafted messages",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_schedule",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Daily Morning Trigger",
            "templateType": "trigger_schedule",
            "config": {
              "cron": "0 9 * * *"
            }
          }
        },
        {
          "id": "node_2",
          "type": "action_memory_search",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Find Pending Follow-Ups",
            "templateType": "action_memory_search",
            "config": {
              "query": "contacts needing follow-up pending response outreach due"
            }
          }
        },
        {
          "id": "node_3",
          "type": "ai_chat",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Draft Follow-Up Messages",
            "templateType": "ai_chat",
            "config": {
              "model": "default",
              "prompt": "Draft personalized follow-up messages for each of these contacts. Keep the tone professional but warm. Reference previous interactions where possible:\n\n{{input.text}}",
              "temperature": 0.6
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Send Reminders",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    },
    {
      "name": "Deal Won Celebration",
      "description": "Generate a celebration message for a won deal and save it to memory",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_manual",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Start",
            "templateType": "trigger_manual",
            "config": {}
          }
        },
        {
          "id": "node_2",
          "type": "ai_chat",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Generate Celebration",
            "templateType": "ai_chat",
            "config": {
              "model": "default",
              "prompt": "Generate an enthusiastic celebration message for this won deal. Include key deal details, the win amount, and a motivational note for the team:\n\n{{input.text}}",
              "temperature": 0.8
            }
          }
        },
        {
          "id": "node_3",
          "type": "action_memory_store",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Save Deal Won",
            "templateType": "action_memory_store",
            "config": {
              "content": "Deal won: {{input.text}}"
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Send Celebration",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    }
  ]
}
