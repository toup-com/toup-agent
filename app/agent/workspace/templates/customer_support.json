{
  "name": "customer_support",
  "keywords": ["support", "customer service", "helpdesk", "ticket", "help", "service", "complaint", "feedback", "customer", "resolution"],
  "description": "Customer support workflows for ticket routing, auto-replies, and escalation handling",
  "workflows": [
    {
      "name": "Ticket Router",
      "description": "Receives a support ticket via webhook, classifies it by category, and routes it accordingly",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_webhook",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Receive Ticket",
            "templateType": "trigger_webhook",
            "config": {
              "method": "POST"
            }
          }
        },
        {
          "id": "node_2",
          "type": "ai_classify",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Classify Ticket",
            "templateType": "ai_classify",
            "config": {
              "model": "default",
              "categories": ["billing", "technical", "general", "urgent"],
              "prompt": "Classify this support ticket into the most appropriate category based on the content:\n\n{{input.text}}"
            }
          }
        },
        {
          "id": "node_3",
          "type": "logic_switch",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Route by Category",
            "templateType": "logic_switch",
            "config": {
              "field": "input.category",
              "cases": ["billing", "technical", "general", "urgent"]
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Return Routing Info",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    },
    {
      "name": "FAQ Auto-Reply",
      "description": "Searches the knowledge base for relevant answers and generates a helpful response",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_manual",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Start",
            "templateType": "trigger_manual",
            "config": {}
          }
        },
        {
          "id": "node_2",
          "type": "action_memory_search",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Search Knowledge Base",
            "templateType": "action_memory_search",
            "config": {
              "query": "{{input.text}}"
            }
          }
        },
        {
          "id": "node_3",
          "type": "ai_chat",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Generate Answer",
            "templateType": "ai_chat",
            "config": {
              "model": "default",
              "prompt": "You are a helpful customer support agent. Using the following knowledge base context, generate a clear and friendly answer to the customer's question. If the context doesn't contain enough information, say so politely.\n\nContext: {{input.context}}\n\nQuestion: {{input.text}}",
              "temperature": 0.3
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Send Reply",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    },
    {
      "name": "Escalation Alert",
      "description": "Classifies ticket severity and sends a Telegram alert for critical issues",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_webhook",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Receive Ticket",
            "templateType": "trigger_webhook",
            "config": {
              "method": "POST"
            }
          }
        },
        {
          "id": "node_2",
          "type": "ai_classify",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Classify Severity",
            "templateType": "ai_classify",
            "config": {
              "model": "default",
              "categories": ["low", "medium", "high", "critical"],
              "prompt": "Assess the severity of this support ticket based on urgency, impact, and customer sentiment:\n\n{{input.text}}"
            }
          }
        },
        {
          "id": "node_3",
          "type": "logic_if",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Is Critical?",
            "templateType": "logic_if",
            "config": {
              "condition": "input.category === 'critical'"
            }
          }
        },
        {
          "id": "node_4",
          "type": "action_send_telegram",
          "position": {"x": 850, "y": 100},
          "data": {
            "label": "Send Urgent Escalation",
            "templateType": "action_send_telegram",
            "config": {
              "message": "CRITICAL ESCALATION: {{input.text}}"
            }
          }
        },
        {
          "id": "node_5",
          "type": "output_log",
          "position": {"x": 850, "y": 300},
          "data": {
            "label": "Log Non-Critical",
            "templateType": "output_log",
            "config": {
              "message": "Ticket classified as {{input.category}}: {{input.text}}"
            }
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"},
        {"id": "e4", "source": "node_3", "target": "node_5"}
      ]
    }
  ]
}
