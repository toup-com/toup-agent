{
  "name": "ecommerce",
  "keywords": ["ecommerce", "e-commerce", "shop", "store", "product", "order", "inventory", "retail", "sell", "amazon", "shopify", "customer"],
  "description": "Workflows for e-commerce: order digests, stock alerts, and customer review responses",
  "workflows": [
    {
      "name": "Order Alert Digest",
      "description": "Fetches recent orders every morning at 9 AM and delivers a summarized digest",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_schedule",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Daily 9 AM",
            "templateType": "trigger_schedule",
            "config": {
              "cron": "0 9 * * *"
            }
          }
        },
        {
          "id": "node_2",
          "type": "action_http",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Fetch Orders",
            "templateType": "action_http",
            "config": {
              "method": "GET",
              "url": "{{config.orders_api_url}}",
              "headers": {
                "Authorization": "Bearer {{config.api_key}}"
              }
            }
          }
        },
        {
          "id": "node_3",
          "type": "ai_chat",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Summarize Orders",
            "templateType": "ai_chat",
            "config": {
              "model": "default",
              "prompt": "Summarize these orders into a daily digest. Include: total orders, total revenue, top products, any issues or returns. Format clearly.\n\nOrders: {{input.response}}",
              "temperature": 0.4
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Send Digest",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    },
    {
      "name": "Low Stock Alert",
      "description": "Checks inventory levels daily at 8 AM and sends a Telegram alert for low-stock items",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_schedule",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Daily 8 AM",
            "templateType": "trigger_schedule",
            "config": {
              "cron": "0 8 * * *"
            }
          }
        },
        {
          "id": "node_2",
          "type": "action_http",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Check Inventory",
            "templateType": "action_http",
            "config": {
              "method": "GET",
              "url": "{{config.inventory_api_url}}",
              "headers": {
                "Authorization": "Bearer {{config.api_key}}"
              }
            }
          }
        },
        {
          "id": "node_3",
          "type": "logic_if",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Low Stock?",
            "templateType": "logic_if",
            "config": {
              "condition": "{{input.low_stock_items.length}} > 0"
            }
          }
        },
        {
          "id": "node_4",
          "type": "action_send_telegram",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Send Stock Alert",
            "templateType": "action_send_telegram",
            "config": {
              "message": "Low Stock Alert!\n\nThe following items are running low:\n{{input.low_stock_items}}\n\nPlease reorder soon."
            }
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    },
    {
      "name": "Customer Review Responder",
      "description": "Receives customer reviews via webhook, classifies sentiment, and drafts an appropriate response",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_webhook",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Receive Review",
            "templateType": "trigger_webhook",
            "config": {
              "method": "POST"
            }
          }
        },
        {
          "id": "node_2",
          "type": "ai_classify",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Classify Sentiment",
            "templateType": "ai_classify",
            "config": {
              "prompt": "Classify the sentiment of this customer review.",
              "categories": ["positive", "negative", "neutral"]
            }
          }
        },
        {
          "id": "node_3",
          "type": "ai_chat",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Draft Response",
            "templateType": "ai_chat",
            "config": {
              "model": "default",
              "prompt": "Draft a professional response to this customer review. The sentiment is {{input.category}}. Be empathetic for negative reviews, grateful for positive ones, and helpful for neutral ones.\n\nReview: {{input.text}}",
              "temperature": 0.6
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Show Response",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    }
  ]
}
