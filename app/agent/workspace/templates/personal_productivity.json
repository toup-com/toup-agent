{
  "name": "personal_productivity",
  "keywords": ["productivity", "organize", "daily", "planning", "habits", "routine", "time management", "tasks", "reminders", "personal", "schedule", "life"],
  "description": "Workflows to organize your day, capture ideas, and build productive habits",
  "workflows": [
    {
      "name": "Morning Briefing",
      "description": "Compiles a daily morning briefing from your stored memories and delivers it at 9 AM",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_schedule",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Every Morning 9 AM",
            "templateType": "trigger_schedule",
            "config": {
              "cron": "0 9 * * *"
            }
          }
        },
        {
          "id": "node_2",
          "type": "ai_agent",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Compile Briefing",
            "templateType": "ai_agent",
            "config": {
              "prompt": "Compile a concise morning briefing. Include: upcoming tasks, pending reminders, recent notes, and anything important from yesterday. Format with clear sections.",
              "model": "default"
            }
          }
        },
        {
          "id": "node_3",
          "type": "output_respond",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Send Briefing",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"}
      ]
    },
    {
      "name": "End-of-Day Review",
      "description": "Searches today's activities at 6 PM, summarizes the day, and stores the summary in memory",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_schedule",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Every Evening 6 PM",
            "templateType": "trigger_schedule",
            "config": {
              "cron": "0 18 * * *"
            }
          }
        },
        {
          "id": "node_2",
          "type": "action_memory_search",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Search Today's Activities",
            "templateType": "action_memory_search",
            "config": {
              "query": "today's activities, tasks completed, notes taken"
            }
          }
        },
        {
          "id": "node_3",
          "type": "ai_chat",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Summarize Day",
            "templateType": "ai_chat",
            "config": {
              "model": "default",
              "prompt": "Summarize today's activities into a concise end-of-day review. Highlight accomplishments, pending items, and key takeaways. Activities: {{input.results}}",
              "temperature": 0.5
            }
          }
        },
        {
          "id": "node_4",
          "type": "action_memory_store",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Save Daily Summary",
            "templateType": "action_memory_store",
            "config": {
              "content": "{{input.text}}",
              "metadata": {
                "type": "daily_summary"
              }
            }
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    },
    {
      "name": "Quick Capture to Memory",
      "description": "Manually capture any thought or note, extract key information, and store it in memory",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_manual",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Capture Input",
            "templateType": "trigger_manual",
            "config": {}
          }
        },
        {
          "id": "node_2",
          "type": "ai_extract",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Extract Key Info",
            "templateType": "ai_extract",
            "config": {
              "prompt": "Extract the key information from this input. Identify: main topic, action items, dates, and people mentioned.",
              "fields": ["topic", "action_items", "dates", "people"]
            }
          }
        },
        {
          "id": "node_3",
          "type": "action_memory_store",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Store in Memory",
            "templateType": "action_memory_store",
            "config": {
              "content": "{{input.extracted}}"
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Confirm Saved",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    }
  ]
}
