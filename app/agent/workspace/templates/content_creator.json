{
  "name": "content_creator",
  "keywords": ["content", "creator", "blog", "social media", "video", "youtube", "instagram", "tiktok", "writing", "podcast", "newsletter", "publish"],
  "description": "Workflows for content creators to plan, draft, and track content across platforms",
  "workflows": [
    {
      "name": "Content Calendar Reminder",
      "description": "Every Monday morning, searches your saved content plans and drafts a weekly content calendar",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_schedule",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Weekly Monday Trigger",
            "templateType": "trigger_schedule",
            "config": {
              "cron": "0 9 * * 1"
            }
          }
        },
        {
          "id": "node_2",
          "type": "action_memory_search",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Search Content Plans",
            "templateType": "action_memory_search",
            "config": {
              "query": "content plans and upcoming topics"
            }
          }
        },
        {
          "id": "node_3",
          "type": "ai_chat",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Draft Weekly Plan",
            "templateType": "ai_chat",
            "config": {
              "model": "default",
              "prompt": "Based on the following content plans and notes, draft this week's content calendar with specific posts, platforms, and suggested times:\n\n{{input.text}}",
              "temperature": 0.7
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Send Plan",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    },
    {
      "name": "Social Post Drafter",
      "description": "Generate a ready-to-publish social media post from a topic or idea",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_manual",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Start",
            "templateType": "trigger_manual",
            "config": {}
          }
        },
        {
          "id": "node_2",
          "type": "ai_agent",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Generate Social Post",
            "templateType": "ai_agent",
            "config": {
              "model": "default",
              "prompt": "You are a social media expert. Generate an engaging social media post based on this topic. Include relevant hashtags, a compelling hook, and a call to action. Adapt the tone for the specified platform.\n\nTopic: {{input.text}}",
              "temperature": 0.8
            }
          }
        },
        {
          "id": "node_3",
          "type": "output_respond",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Return Post",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"}
      ]
    },
    {
      "name": "Weekly Analytics Summary",
      "description": "Every Friday, compiles a summary of your content performance from saved notes",
      "nodes_json": [
        {
          "id": "node_1",
          "type": "trigger_schedule",
          "position": {"x": 100, "y": 200},
          "data": {
            "label": "Friday Trigger",
            "templateType": "trigger_schedule",
            "config": {
              "cron": "0 10 * * 5"
            }
          }
        },
        {
          "id": "node_2",
          "type": "action_memory_search",
          "position": {"x": 350, "y": 200},
          "data": {
            "label": "Search Performance Notes",
            "templateType": "action_memory_search",
            "config": {
              "query": "content performance metrics and engagement notes"
            }
          }
        },
        {
          "id": "node_3",
          "type": "ai_chat",
          "position": {"x": 600, "y": 200},
          "data": {
            "label": "Compile Analytics Summary",
            "templateType": "ai_chat",
            "config": {
              "model": "default",
              "prompt": "Compile a weekly analytics summary from these content performance notes. Highlight top-performing content, engagement trends, and actionable recommendations for next week:\n\n{{input.text}}",
              "temperature": 0.5
            }
          }
        },
        {
          "id": "node_4",
          "type": "output_respond",
          "position": {"x": 850, "y": 200},
          "data": {
            "label": "Send Summary",
            "templateType": "output_respond",
            "config": {}
          }
        }
      ],
      "edges_json": [
        {"id": "e1", "source": "node_1", "target": "node_2"},
        {"id": "e2", "source": "node_2", "target": "node_3"},
        {"id": "e3", "source": "node_3", "target": "node_4"}
      ]
    }
  ]
}
