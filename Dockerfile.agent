# Agent container — runs one user's agent on the managed Docker host
FROM python:3.12-slim

WORKDIR /app

# System deps + Chromium runtime libraries (browser binary mounted from host)
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    curl \
    git \
    # Chromium runtime deps for Playwright/Patchright headless browser
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libwayland-client0 \
    # LibreOffice — DOCX/PPTX → PDF preview (doc-delivery feature).
    # Core + writer + impress only; calc is excluded because XLSX
    # preview uses openpyxl → HTML (lighter and sheet-tab interactive).
    libreoffice-core \
    libreoffice-writer \
    libreoffice-impress \
    # libmagic — used by python-magic for content-type sniffing in
    # several adapters (file-upload routes, doc-delivery). Cheap to
    # keep installed even if no current code path requires it.
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Node.js 20 — needed for Expo project scaffolding and preview servers
# NOTE: Do NOT install expo-cli globally — it's the legacy CLI that doesn't support
# Node 17+. The local @expo/cli (via npx expo) is the correct one and comes from
# each app's node_modules after `npx create-expo-app`.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.agent.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# WhatsApp sidecar — Baileys (Node.js) handles QR pairing because
# Meta's anti-abuse rejects clients with stale `version` triples and
# Baileys' `fetchLatestBaileysVersion()` is the only reliable way to
# stay current. Install BEFORE `COPY . .` so node_modules is cached
# across rebuilds when only Python code changes.
COPY whatsapp_sidecar/package.json whatsapp_sidecar/package.json
RUN cd whatsapp_sidecar && npm install --omit=dev --no-audit --no-fund

# Agent code
COPY . .

# Non-root user + workspace (don't chown /app recursively — pip packages are huge)
RUN useradd -m -u 1000 toup && \
    mkdir -p /app/workspace /app/skills && \
    chown -R toup:toup /app/workspace /app/skills /home/toup

# Memory & retrieval — agent containers do NOT bundle
# `sentence-transformers`/torch (saves ~2.5 GB image weight). The
# embedding service falls back to "local" mode by default and dies
# with `No module named 'sentence_transformers'`, which silently
# breaks BOTH automatic memory extraction and recall — so the agent's
# Brain stays empty forever and `memory_search` always returns
# "failed". OPENAI_API_KEY is reliably injected per-tenant by the
# bridge, so default the agent image to OpenAI embeddings; settings
# can still be overridden via .env if a tenant needs local.
ENV EMBEDDING_PROVIDER=openai \
    EMBEDDING_MODEL=text-embedding-3-small \
    EMBEDDING_DIMENSION=1536

# Cross-day recall — without this, the agent's `recall_day` tool
# returns "ERROR: recall_day is not enabled on this agent" and the
# user sees "session history tool bugged out on me. Lovely 😑". For
# per-tenant agents the user explicitly expects "remember things
# from yesterday" behavior across channels (WhatsApp ↔ web ↔ mobile),
# so this should be on by default in the agent image. Tenant can
# still flip it off via `.env` if needed.
ENV ENABLE_DAY_RECALL=true

# Routines (email briefing + reminders) — flag-gated in code but
# every per-tenant agent ships with the feature ON. Pre-2026-05-18
# the defaults were False so the agent skill returned "Feature not
# available" when a user asked for a daily Gmail briefing. The gate
# remains for staged rollouts; this default flips it on per-agent
# without changing the platform-side default.
ENV ROUTINES_EMAIL_BRIEFING_ENABLED=true \
    ROUTINES_REMINDERS_ENABLED=true
# Autopilot staged rollout — admin + canary tenants only (nariman,
# mrhx, canary). Flip AUTOPILOT_ENABLED=true to go image-global; see
# app/agent/autopilot_gate.py.
ENV AUTOPILOT_USER_ALLOWLIST="871bac24-c366-42b5-b224-8802c73aef3a,c47c5b4b-16d2-498c-b231-15d53d7454b9,533354ce-40c5-41b6-81a8-e87e33a08a24"

# Agent listens on 8001 internally (mapped to unique host port)
EXPOSE 8001

# Health check — hits the public /agent/health endpoint
# Generous retries (5) to avoid false unhealthy during long builds (npm install, code gen)
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD curl -sf http://localhost:8001/agent/health || exit 1

# Apply pending Alembic migrations before serving requests, then start
# uvicorn. Best-effort: if upgrade fails (env, race, transient DB
# hiccup) the container still serves so the user isn't locked out;
# the failure is loud in stdout for the operator. This mirrors the
# platform Dockerfile's pattern. Before 2026-05-18 the agent never
# ran migrations on boot — tenant DBs drifted behind the model
# definitions, surfacing as "column X of relation Y does not exist"
# the moment a new feature column was referenced (e.g. routines.schedule_kind
# from migration 042 broke every reminder create call).
CMD ["bash", "-c", "alembic upgrade head || echo '[boot] alembic upgrade failed — continuing without applying migrations; check logs above'; exec uvicorn agent_main:app --host 0.0.0.0 --port 8001"]
