# Agent container — runs one user's agent on the managed Docker host
FROM python:3.12-slim

WORKDIR /app

# System deps + Chromium runtime libraries (browser binary mounted from host)
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    curl \
    git \
    # Chromium runtime deps for Playwright/Patchright headless browser
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libwayland-client0 \
    # LibreOffice — DOCX/PPTX → PDF preview (doc-delivery feature).
    # Core + writer + impress only; calc is excluded because XLSX
    # preview uses openpyxl → HTML (lighter and sheet-tab interactive).
    libreoffice-core \
    libreoffice-writer \
    libreoffice-impress \
    # libmagic — used by python-magic for content-type sniffing in
    # several adapters (file-upload routes, doc-delivery). Cheap to
    # keep installed even if no current code path requires it.
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Node.js 20 — needed for Expo project scaffolding and preview servers
# NOTE: Do NOT install expo-cli globally — it's the legacy CLI that doesn't support
# Node 17+. The local @expo/cli (via npx expo) is the correct one and comes from
# each app's node_modules after `npx create-expo-app`.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.agent.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# WhatsApp sidecar — Baileys (Node.js) handles QR pairing because
# Meta's anti-abuse rejects clients with stale `version` triples and
# Baileys' `fetchLatestBaileysVersion()` is the only reliable way to
# stay current. Install BEFORE `COPY . .` so node_modules is cached
# across rebuilds when only Python code changes.
COPY whatsapp_sidecar/package.json whatsapp_sidecar/package.json
RUN cd whatsapp_sidecar && npm install --omit=dev --no-audit --no-fund

# Agent code
COPY . .

# Non-root user + workspace (don't chown /app recursively — pip packages are huge)
RUN useradd -m -u 1000 toup && \
    mkdir -p /app/workspace /app/skills && \
    chown -R toup:toup /app/workspace /app/skills /home/toup

# `exec` sandboxing (security hardening, docs/security/audit-2026.md EXF-3).
# The agent process runs as root (trusted supervisor). When EXEC_SANDBOX_USER is
# set, every `exec`/PTY/process child is dropped to THAT uid via preexec_fn, so a
# tenant's shell command (or injected content that reaches exec) can no longer
# read the platform source at /app NOR the agent's secrets via
# /proc/<agent-pid>/environ — while the agent itself is unaffected.
#
# Default = `toup` (uid 1000), the user that OWNS /app/workspace, so a dropped
# exec keeps full read+write on the USER's workspace (no build/exec breakage)
# yet is a different uid from the root agent (→ /proc secrets denied) and cannot
# read the shipped source:
#   * `chmod -R o-rwx /app`  → source unreadable to any non-root uid.
#   * `chmod o+x /app`       → re-grant TRAVERSE (not read) on the /app dir so the
#                              dropped exec can reach /app/workspace; `ls /app`
#                              and reading /app/app/** stay denied (x without r).
# A stricter, fully-isolated `sandbox` uid (2000, zero workspace access) is also
# defined for future use — switch EXEC_SANDBOX_USER to it after making the
# workspace group-2000-writable.
RUN useradd -u 2000 -M -d /home/sandbox -s /usr/sbin/nologin sandbox && \
    mkdir -p /home/sandbox && chown sandbox:sandbox /home/sandbox && \
    chmod -R o-rwx /app && \
    chmod o+x /app

# Enable the exec drop by default: exec/PTY/process children run as `toup`, not
# as the root agent. Closes the exec→/proc-secret and exec→/app-source paths
# (EXF-3). Reversible per-agent via `.env` EXEC_SANDBOX_USER="" (exec runs root).
ENV EXEC_SANDBOX_USER=toup

# Memory & retrieval — agent containers do NOT bundle
# `sentence-transformers`/torch (saves ~2.5 GB image weight). The
# embedding service falls back to "local" mode by default and dies
# with `No module named 'sentence_transformers'`, which silently
# breaks BOTH automatic memory extraction and recall — so the agent's
# Brain stays empty forever and `memory_search` always returns
# "failed". EMBEDDING_PROVIDER=openai alone is NOT enough: bundle-mode
# containers are KEYLESS (no OPENAI_API_KEY — chat rides TOUP_TOKEN
# through the platform proxy), and EmbeddingService.provider resolves
# "openai" only with a raw key OR the proxy escape hatch
# (_proxy_embeddings_active). Without EMBEDDINGS_VIA_PROXY it silently
# fell back to "local" and memory_store errored with the missing
# import (canary 533354ce, 2026-07-28). Pin the proxy flag here so
# embeddings ride the TOUP_TOKEN through /llm/openai/v1/embeddings —
# the same OpenAI embeddings memory_create uses platform-side.
# Settings can still be overridden via .env if a tenant needs local.
ENV EMBEDDING_PROVIDER=openai \
    EMBEDDING_MODEL=text-embedding-3-small \
    EMBEDDING_DIMENSION=1536 \
    EMBEDDINGS_VIA_PROXY=true

# Cross-day recall — without this, the agent's `recall_day` tool
# returns "ERROR: recall_day is not enabled on this agent" and the
# user sees "session history tool bugged out on me. Lovely 😑". For
# per-tenant agents the user explicitly expects "remember things
# from yesterday" behavior across channels (WhatsApp ↔ web ↔ mobile),
# so this should be on by default in the agent image. Tenant can
# still flip it off via `.env` if needed.
ENV ENABLE_DAY_RECALL=true

# Routines (email briefing + reminders) — flag-gated in code but
# every per-tenant agent ships with the feature ON. Pre-2026-05-18
# the defaults were False so the agent skill returned "Feature not
# available" when a user asked for a daily Gmail briefing. The gate
# remains for staged rollouts; this default flips it on per-agent
# without changing the platform-side default.
ENV ROUTINES_EMAIL_BRIEFING_ENABLED=true \
    ROUTINES_REMINDERS_ENABLED=true
# Autopilot staged rollout — admin + canary tenants (nariman, mrhx,
# canary) plus the founder's phone test account (korsishare). Flip
# AUTOPILOT_ENABLED=true to go image-global; see
# app/agent/autopilot_gate.py.
ENV AUTOPILOT_USER_ALLOWLIST="871bac24-c366-42b5-b224-8802c73aef3a,c47c5b4b-16d2-498c-b231-15d53d7454b9,533354ce-40c5-41b6-81a8-e87e33a08a24,e5ec1759-84ac-45bb-b2ec-bc85fa932211"

# Sub-agent spawning — unified job path, image-wide default ON.
# Every other enable lever is structurally dead for managed tenants:
# pool binds don't carry the flag (_build_bind_payload/_BIND_FIELDS
# lack it) and the deployed bridge AgentConfig drops it, so tenants
# fell to the legacy Telegram-only path and web/mobile/autopilot
# spawns errored SUBAGENT_LEGACY_TELEGRAM_ONLY (founder repro
# 2026-07-16). The real guardrails are the dispatcher caps (depth 1,
# 5 children/parent, 3 concurrent/user, 50 per user/24h, 900s wall
# clock); tenant `.env` (--env-file) can still override to false,
# and removing this line + rollout is the fleet kill switch.
ENV SUBAGENT_SPAWNING_ENABLED=true

# Agent listens on 8001 internally (mapped to unique host port)
EXPOSE 8001

# Health check — hits the public /agent/health endpoint
# Generous retries (5) to avoid false unhealthy during long builds (npm install, code gen)
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD curl -sf http://localhost:8001/agent/health || exit 1

# Apply pending Alembic migrations before serving requests, then start
# uvicorn. Best-effort: if upgrade fails (env, race, transient DB
# hiccup) the container still serves so the user isn't locked out;
# the failure is loud in stdout for the operator. This mirrors the
# platform Dockerfile's pattern. Before 2026-05-18 the agent never
# ran migrations on boot — tenant DBs drifted behind the model
# definitions, surfacing as "column X of relation Y does not exist"
# the moment a new feature column was referenced (e.g. routines.schedule_kind
# from migration 042 broke every reminder create call).
# Ensure the workspace/skills are owned by `toup` (uid 1000) at boot — a dropped
# `exec` runs as toup and must read+write them. Covers the case where a runtime
# mount arrives owned by another uid. Best-effort; never fails boot.
CMD ["bash", "-c", "chown -R toup:toup /app/workspace /app/skills 2>/dev/null || true; alembic upgrade head || echo '[boot] alembic upgrade failed — continuing without applying migrations; check logs above'; exec uvicorn agent_main:app --host 0.0.0.0 --port 8001"]
