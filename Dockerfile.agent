# Agent container — runs one user's agent on the managed Docker host
FROM python:3.12-slim

WORKDIR /app

# System deps + Chromium runtime libraries (browser binary mounted from host)
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    curl \
    git \
    # Chromium runtime deps for Playwright/Patchright headless browser
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libwayland-client0 \
    && rm -rf /var/lib/apt/lists/*

# Node.js 20 — needed for Expo project scaffolding and preview servers
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/* && \
    npm install -g expo-cli@latest

# Python deps
COPY requirements.agent.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Agent code
COPY . .

# Non-root user + workspace (don't chown /app recursively — pip packages are huge)
RUN useradd -m -u 1000 toup && \
    mkdir -p /app/workspace /app/skills && \
    chown -R toup:toup /app/workspace /app/skills /home/toup

# Agent listens on 8001 internally (mapped to unique host port)
EXPOSE 8001

# Health check — hits the public /agent/health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:8001/agent/health || exit 1

CMD ["uvicorn", "agent_main:app", "--host", "0.0.0.0", "--port", "8001"]
